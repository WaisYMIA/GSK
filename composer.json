{
  "name": "gsk/global-skills-kenya",
  "type": "project",
  "description": "Global Skills Kenya candidate training, employment and welfare platform scaffold",
  "require": {"php": "^8.3", "laravel/framework": "^12.0", "laravel/sanctum": "^4.0"},
  "require-dev": {"phpunit/phpunit": "^11.0", "laravel/pint": "^1.0"},
  "autoload": {"psr-4": {"App\\\\": "app/", "Database\\\\Factories\\\\": "database/factories/", "Database\\\\Seeders\\\\": "database/seeders/"}},
  "autoload-dev": {"psr-4": {"Tests\\\\": "tests/"}},
  "scripts": {"test": "@php artisan test", "post-autoload-dump": ["Illuminate\\\\Foundation\\\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"]},
  "minimum-stability": "stable", "prefer-stable": true
}
